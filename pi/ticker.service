[Unit]
Description=Bar ticker
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/pi/bar-ticker
# the LED library's Python part lives in /home/pi/env (Adafruit's installer); fall back to the system Python without it
ExecStart=/bin/sh -c 'if [ -x /home/pi/env/bin/python3 ]; then exec /home/pi/env/bin/python3 ticker.py; else exec /usr/bin/python3 ticker.py; fi'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
